<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required on every supported level (design §4). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Install-time, no runtime prompt (design §8.2/C-06) - required to hold the
         MulticastLock the LAN sweep's mDNS/SSDP/NetBIOS probes need, since the Wi-Fi driver
         drops inbound multicast to save power without it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- design §8.4 - required to hold the WifiLock (WIFI_MODE_FULL_LOW_LATENCY) the LAN sweep
         acquires for its duration, without which WifiLock.acquire() throws a SecurityException
         at runtime rather than failing at compile or install time. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Unredacts the *connected* network's SSID/BSSID on the dashboard (C-04) AND gates
         the AP scan list on the Wi-Fi screen (C-03) - the same permission covers both,
         despite two earlier design drafts each assuming only one of them needed it and
         that the other needed NEARBY_WIFI_DEVICES instead (neither draft's assumption
         survived device testing; see C-03/C-04's AOSP source trails). Requested lazily
         from whichever screen needs it first, not at first launch. COARSE is deliberately
         not requested alongside it: the AOSP trace for both call paths shows FINE is
         required specifically at this targetSdk (COARSE only satisfies it for
         targetSdk < 29), so declaring COARSE would offer a fallback that can't actually
         unlock anything. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />

    <application
        android:name=".NetInspectorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.NetInspector">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NetInspector">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 8 - the default androidx.startup-driven WorkManagerInitializer runs as a
             ContentProvider before Application.onCreate(), too early for Hilt to have
             field-injected HiltWorkerFactory yet. WorkManager.initialize() is called manually
             from NetInspectorApplication.onCreate() instead, once injection has completed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
